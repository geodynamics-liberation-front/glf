{
  "name": "glf",
  "private": true,
  "description": "Geodynamics Liberation Front: website, project catalog and tools",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build.mjs --no-projects",
    "serve": "python3 -m http.server 8080 --directory dist",
    "clean": "rm -rf dist",
    "background": "node backgrounds/fetch.mjs",
    "deploy": "npx wrangler@4 pages deploy dist --project-name=glf --branch=main --commit-dirty=true",
    "thumbnails": "node scripts/thumbnail.mjs --all",
    "publish": "(npm run background || true) && npm run build && npm run deploy"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
