# Cloudflare Pages headers. The project data files carry a version in their
# query string, so they can be cached for a long time; the rest for a day.
/projects/:slug/data/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=86400
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
